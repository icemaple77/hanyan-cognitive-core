HCC_DATABASE_URL=postgresql+asyncpg://hcc:hcc@localhost:5433/hcc
HCC_DEBUG=false

# --- v2 Knowledge Layer -------------------------------------------------
# Redis working memory / event bus
HCC_REDIS_URL=redis://localhost:6379/0
# Working-memory default TTLs (seconds)
HCC_TTL_CHAT=1800
HCC_TTL_TASK=3600
HCC_TTL_PROMPT=3600
HCC_TTL_EMBEDDING=604800
# Event bus
HCC_EVENT_CHANNEL_PREFIX=hcc:events
HCC_EVENT_SOURCE=hcc
# QMD knowledge document generator
HCC_QMD_DIR=./qmd
HCC_QMD_GIT_ENABLED=false
