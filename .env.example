# HCC (Hanyan Cognitive Core) — environment configuration template
# Copy to .env and adjust. All keys are HCC_-prefixed and read via
# Pydantic Settings (gateway/core/config.py, core/config.py) or os.getenv
# at the call site — see each module's docstring for the authoritative list.

# --- Database (required) -------------------------------------------------
HCC_DATABASE_URL=postgresql+asyncpg://hcc:hcc@localhost:5433/hcc
HCC_DEBUG=false

# --- Redis working memory / event bus (optional) -------------------------
# Master switch — false runs the EventBus on an in-process in-memory broker,
# no external Redis dependency required.
HCC_REDIS_ENABLED=false
HCC_REDIS_URL=redis://localhost:6379/0
HCC_TTL_CHAT=1800
HCC_TTL_TASK=3600
HCC_TTL_PROMPT=3600
HCC_TTL_EMBEDDING=604800
HCC_EVENT_CHANNEL_PREFIX=hcc:events
HCC_EVENT_SOURCE=hcc

# --- Embeddings ------------------------------------------------------------
# Provider: hash (no dependency, dev/testing) | ollama | sentence-transformers
# hash is a lexical-hash placeholder, not real semantic search — fine for
# schema/dev work, but wrong for any real deployment. This project's own
# server runs HCC_EMBEDDING_PROVIDER=ollama with qwen3-embedding:0.6b (1024-dim,
# `ollama pull qwen3-embedding:0.6b`; stronger Chinese semantics than
# nomic-embed-text, which this project used before 2026-08); dim must match
# whatever model you pick (bge-m3 is 1024-dim, nomic-embed-text is 768-dim) —
# mismatches fail inserts, not silently corrupt data, since the pgvector
# column has a fixed width.
HCC_EMBEDDING_PROVIDER=hash
HCC_EMBEDDING_MODEL=BAAI/bge-m3
HCC_EMBEDDING_DIM=1024
HCC_OLLAMA_URL=http://localhost:11434

# --- Hybrid search reranking (optional, off by default) -------------------
# Cross-encoder rerank of the fused BM25+vector top results. Requires the
# `rerank` extra (llama-cpp-python) and a local GGUF model; hybrid search's
# BM25+RRF fusion works fully without this.
HCC_RERANK_ENABLED=false
HCC_RERANK_MODEL_PATH=~/.cache/qmd/models/hf_ggml-org_qwen3-reranker-0.6b-q8_0.gguf
HCC_RERANK_N_CTX=2048

# --- Local-model noise filter (optional, on by default) --------------------
# Async, event-driven review of low-trust memory writes (type=tool_result or
# source=openclaw_plugin) via a local Ollama model. Never blocks
# /memory/store; a low-value verdict soft-deletes (status=discarded).
HCC_NOISE_FILTER_ENABLED=true
HCC_NOISE_FILTER_MODEL=qwen3.5:4b
HCC_NOISE_FILTER_OLLAMA_URL=http://localhost:11434
HCC_NOISE_FILTER_TIMEOUT=15
HCC_NOISE_FILTER_CONCURRENCY=4
HCC_NOISE_FILTER_TRUNCATE_CHARS=1500

# --- QMD knowledge document generator / Obsidian sync -----------------------
HCC_QMD_DIR=./qmd
HCC_QMD_GIT_ENABLED=false
HCC_SYNC_INTERVAL=300
HCC_SYNC_GIT_ENABLED=false
HCC_SYNC_AUTO_ENABLED=true

# --- Obsidian vault integration (archive / per-agent export / vault API) ---
HCC_VAULT_ROOT=~/workspace/AICore
HCC_ARCHIVE_DIR=~/workspace/AICore-Archive
HCC_AGENT_EXPORT_DIR=~/workspace/AICore/agents

# --- Dream engine (three-phase memory consolidation) -----------------------
HCC_DREAM_AUTO_ENABLED=true
HCC_DREAM_LIGHT_INTERVAL_HOURS=6
HCC_DREAM_REM_HOUR=2
HCC_DREAM_REM_MINUTE=30
HCC_DREAM_DEEP_HOUR=3
HCC_DREAM_DEEP_MINUTE=0
HCC_DREAM_DIARY_DIR=~/workspace/AICore/Dreams

# --- Context API defaults ---------------------------------------------------
HCC_CONTEXT_DEFAULT_LIMIT=10
HCC_CONTEXT_MAX_LIMIT=50

# --- SSE events endpoint -----------------------------------------------------
HCC_EVENTS_ENABLED=true
